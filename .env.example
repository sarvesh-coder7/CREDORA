# =============================================================================
# CREDORA - Lending & Credit Platform Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit the actual .env file to version control.

# -----------------------------------------------------------------------------
# Google Gemini AI Service Configuration (ai-server/ & document_analyzer.py)
# -----------------------------------------------------------------------------
# Required for AI document analysis. Supported models: gemini-2.0-flash, gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=2

# Optional: internal API key to protect /extract and /analyze endpoints.
# Leave empty for development mode (authentication disabled).
AI_SERVER_API_KEY=

# Port 8001 AI Service settings
MAX_FILE_SIZE_MB=20
MAX_TOTAL_UPLOAD_SIZE_MB=50
MAX_FILES_PER_REQUEST=10
EXTRACTION_TIMEOUT_SECONDS=60.0
OCR_TIMEOUT_SECONDS=30.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# -----------------------------------------------------------------------------
# Main Backend Configuration (backend/main.py)
# -----------------------------------------------------------------------------
# AI Service URL that the main backend proxies requests to
AI_SERVICE_URL=http://127.0.0.1:8001

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# Email / Notification Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SENDER_EMAIL=noreply@credora.example.com
SENDER_NAME=CREDORA Notifications
